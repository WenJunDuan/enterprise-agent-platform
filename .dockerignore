# VCS / tooling
.git
.gitignore
.ai_state
.ruff_cache
**/.DS_Store
tests

# Python virtualenv & caches (host-specific, must not leak into image)
.venv
**/__pycache__
**/*.pyc
**/*.pyo

# Runtime state — provided as mounted volumes, not baked
logs
data
knowledge
backups
docker-export
*.tar
*.tar.gz
*.tar.sha256
prod

# Frontend sources & deps — only the prebuilt agent-front/dist is shipped
agent-front/node_modules
agent-front/src
agent-front/.env.local

# Secrets — supplied at runtime via env_file, never baked into the image
.env
.env*
**/.env
**/.env.local
**/*.env.prod
audit-agent.env
enterprise-agent.env
.claude/settings.local.json

# Large institution source docs (not needed at runtime; only rules JSON is)
knowledge/external
