{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "domain",
    "category",
    "version",
    "effective_date",
    "rules"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "enum": [
        "expense",
        "hr",
        "legal"
      ]
    },
    "category": {
      "type": "string",
      "description": "Rule category such as travel, entertainment, invoice, attendance or leave."
    },
    "version": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "description",
          "conditions",
          "action"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "Format: {domain}.{category}.{index}"
          },
          "description": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "escalate"
            ]
          },
          "priority": {
            "type": "integer"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "original_text": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
