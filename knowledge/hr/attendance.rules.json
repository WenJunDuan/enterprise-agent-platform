{
  "domain": "hr",
  "category": "attendance",
  "version": "2026.03-handbook-v1",
  "effective_date": "2026-03-20",
  "rules": [
    {
      "rule_id": "hr.attendance.001",
      "description": "标准工时制员工每周工作40小时，周一至周五需完成上下班两次打卡",
      "conditions": {
        "weekly_hours": 40,
        "required_daily_punch_count": 2
      },
      "action": "reject",
      "priority": 2,
      "confidence": "high",
      "original_text": "标准工作时间为40小时/周，考勤采取电子打卡形式记录，每日需保证上下班两次打卡。"
    },
    {
      "rule_id": "hr.attendance.002",
      "description": "半天请假、外出或出差时也应保证上班和下班两次打卡",
      "conditions": {
        "applies_to": ["half_day_leave", "business_outing", "business_trip"],
        "required_daily_punch_count": 2
      },
      "action": "reject",
      "priority": 2,
      "confidence": "high",
      "original_text": "若申请半天请假、外出、出差，则在岗时间也要保证上班下班两次打卡。"
    },
    {
      "rule_id": "hr.attendance.003",
      "description": "未事先通知并获批准而不按时出勤视为旷工，连续三日不到岗且无正当理由属于严重违纪",
      "conditions": {
        "absence_without_notice_as_absenteeism": true,
        "serious_violation_after_consecutive_absence_days": 3
      },
      "action": "reject",
      "priority": 1,
      "confidence": "high",
      "original_text": "如不事先通知并获批准而不按时出勤的，则视为旷工；连续不到岗三日或以上者，公司可以解除劳动合同。"
    },
    {
      "rule_id": "hr.attendance.004",
      "description": "员工一个月内旷工2日或季度累计旷工3日，属于严重违反考勤制度",
      "conditions": {
        "serious_violation_monthly_absent_days": 2,
        "serious_violation_quarterly_absent_days": 3
      },
      "action": "reject",
      "priority": 1,
      "confidence": "high",
      "original_text": "员工一个月内旷工2日，或季度内累计旷工3日者，属严重违反公司的考勤管理制度。"
    },
    {
      "rule_id": "hr.attendance.005",
      "description": "休息日加班需系统提交加班申请，临时加班应在次日5个工作日内补流程",
      "conditions": {
        "overtime_request_required": true,
        "late_overtime_application_window_workdays": 5
      },
      "action": "reject",
      "priority": 1,
      "confidence": "high",
      "original_text": "休息日加班需系统提交加班申请，如临时有加班需求，须于加班次日的5个工作日内补走加班申请流程。"
    },
    {
      "rule_id": "hr.attendance.006",
      "description": "法定节假日加班需提前3天提交纸质申请并经总经理审批",
      "conditions": {
        "holiday_overtime_application_days_in_advance": 3,
        "approval_level": "general_manager",
        "required_docs": ["纸质加班申请", "加班人员名单"]
      },
      "action": "reject",
      "priority": 1,
      "confidence": "high",
      "original_text": "法定假日加班，需提交线下纸质加班申请，提前三天提交至总经理审批，并附上加班人员名单。"
    }
  ]
}
