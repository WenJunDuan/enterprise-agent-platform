# LiteLLM 路由配置模板。复制为 litellm_config.yaml 并填真实值（真实文件已 gitignore，勿入库）。
# claude-* 名 → 后端 Qwen（或任意 OpenAI 兼容端点）。运维独立部署管理。
model_list:
  - model_name: claude-opus-4-8
    litellm_params:
      model: openai/qwen3.6
      api_base: <QWEN_API_BASE>          # 例 http://10.x.x.x:8100/v1
      api_key: <YOUR_QWEN_API_KEY>

  - model_name: claude-opus-4-6
    litellm_params:
      model: openai/qwen3.5-122b-a10b
      api_base: <QWEN_API_BASE_2>
      api_key: <YOUR_QWEN_API_KEY>

  - model_name: "*"
    litellm_params:
      model: openai/qwen3.6
      api_base: <QWEN_API_BASE>
      api_key: <YOUR_QWEN_API_KEY>

litellm_settings:
  drop_params: true
  num_retries: 2
