# LiteLLM 代理所需环境变量。复制为 .env（与 litellm_config.yaml 同目录），填入真实值后再起服务。

# Qwen (DashScope) 的 OpenAI 兼容端点：
#   国内： https://dashscope.aliyuncs.com/compatible-mode/v1
#   海外： https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# DashScope / 百炼 API Key。
QWEN_API_KEY=sk-your-dashscope-api-key

# LiteLLM 代理主密钥；客户端用它做 Bearer 鉴权。
# 生成强随机串： openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-change-me
