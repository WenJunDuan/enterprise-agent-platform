{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "legal_contract_extract_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "type": ["string", "null"],
      "description": "合同库主键(UUID，Python 侧生成)；抽取阶段可为 null，落库时补"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "role": {
            "type": ["string", "null"],
            "description": "甲方/乙方/担保方/受托方等"
          }
        },
        "required": ["name", "role"]
      }
    },
    "contract_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": ["string", "null"] },
        "contract_no": { "type": ["string", "null"] },
        "sign_date": { "type": ["string", "null"], "format": "date" },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "term": { "type": ["string", "null"], "description": "合同期限/有效期描述" }
      },
      "required": ["title", "contract_no", "sign_date", "amount", "currency", "term"]
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clause_id": { "type": ["string", "null"] },
          "type": {
            "type": ["string", "null"],
            "description": "付款/违约/保密/知识产权/质保/争议解决等"
          },
          "text": { "type": ["string", "null"] },
          "page": { "type": ["integer", "null"] }
        },
        "required": ["clause_id", "type", "text", "page"]
      }
    },
    "payment_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"], "description": "如 预付款/进度款/质保金" },
          "amount": { "type": ["number", "null"] },
          "ratio": { "type": ["number", "null"], "description": "占合同额比例 0-1" },
          "due_condition": { "type": ["string", "null"], "description": "触发付款的条件" },
          "due_date": { "type": ["string", "null"], "format": "date" },
          "page": { "type": ["integer", "null"] }
        },
        "required": ["node_id", "name", "amount", "ratio", "due_condition", "due_date", "page"]
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "document_type": {
            "type": "string",
            "enum": [
              "main_contract",
              "supplementary_agreement",
              "appendix",
              "payment_schedule",
              "invoice",
              "approval",
              "other"
            ]
          }
        },
        "required": ["name", "path", "media_type", "document_type"]
      }
    },
    "extracted_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewed_by": {
      "type": "string",
      "const": "contract-extractor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_id",
    "source_path",
    "parties",
    "contract_meta",
    "clauses",
    "payment_nodes",
    "attachments",
    "extracted_fields",
    "missing_fields",
    "ambiguities",
    "reviewed_by",
    "timestamp"
  ]
}
