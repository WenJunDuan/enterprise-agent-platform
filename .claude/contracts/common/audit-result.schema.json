{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "audit_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["approved", "rejected", "manual_review"]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "extracted_data": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          }
        },
        "required": ["source", "finding", "conclusion"]
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "manual_review_reason": {
      "type": "string",
      "enum": [
        "missing_approval",
        "rule_gap",
        "data_conflict",
        "insufficient_evidence",
        "budget_exceeded",
        "invoice_invalid",
        "pre_approval_mismatch"
      ]
    },
    "risk_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["invoice", "amount", "approval", "budget", "anomaly"]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    }
  },
  "required": [
    "claim_id",
    "verdict",
    "explanation",
    "reasons",
    "policy_refs",
    "risk_score",
    "extracted_data",
    "evidence_chain",
    "reviewed_by",
    "timestamp"
  ]
}
