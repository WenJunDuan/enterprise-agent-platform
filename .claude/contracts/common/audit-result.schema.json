{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "audit_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["approved", "rejected", "manual_review"]
    },
    "result": {
      "type": "boolean"
    },
    "conclusion": {
      "type": "string",
      "enum": ["合规", "不合规", "待人工复核"]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "extracted_data": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          }
        },
        "required": ["source", "finding", "conclusion"]
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "verdict",
    "result",
    "conclusion",
    "explanation",
    "reasons",
    "policy_refs",
    "risk_score",
    "extracted_data",
    "evidence_chain",
    "reviewed_by",
    "timestamp"
  ]
}
