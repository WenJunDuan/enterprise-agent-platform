{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "audit_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["approved", "rejected", "manual_review"]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "extracted_data": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scoring": {
          "type": "array",
          "description": "逐评分项明细（tender 评标产出；expense 审核无此结构，不受本节约束）。",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "score": {
                "type": ["number", "null"]
              },
              "pending_reason": {
                "type": "string",
                "enum": [
                  "cross_bid",
                  "external_data",
                  "live_event",
                  "evidence_unresolved",
                  "manual_mode",
                  "non_responsive"
                ],
                "description": "score=null 时【必填】的待定原因（服务端语义闸强制）：cross_bid=需全部投标报价横比；external_data=需外部数据（信用等）；live_event=需现场答辩/演示；evidence_unresolved=出处未核实/底稿读不清；manual_mode=评分方式本身为人工主观项；non_responsive=实质性不响应、无可评事实。score 非 null 时不应出现。"
              }
            }
          }
        }
      }
    },
    "evidence_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          }
        },
        "required": ["source", "finding", "conclusion"]
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "manual_review_reason": {
      "type": "string",
      "enum": [
        "missing_approval",
        "rule_gap",
        "data_conflict",
        "insufficient_evidence",
        "budget_exceeded",
        "invoice_invalid",
        "pre_approval_mismatch"
      ]
    },
    "risk_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["invoice", "amount", "approval", "budget", "anomaly"]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    }
  },
  "required": [
    "claim_id",
    "verdict",
    "explanation",
    "reasons",
    "policy_refs",
    "risk_score",
    "extracted_data",
    "evidence_chain",
    "reviewed_by",
    "timestamp"
  ]
}
