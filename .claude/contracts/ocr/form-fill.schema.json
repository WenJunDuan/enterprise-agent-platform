{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "form_fill_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "form_id": { "type": "string" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "component", "value", "confidence"],
        "properties": {
          "key": { "type": "string" },
          "component": {
            "type": "string",
            "enum": ["single_line", "multi_line", "select", "number", "date", "sub_table"]
          },
          "value": {},
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string" }
        }
      }
    },
    "sub_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "rows"],
        "properties": {
          "key": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rows": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "low_confidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_review": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "finding"],
        "properties": {
          "source": { "type": "string" },
          "finding": { "type": "string" }
        }
      }
    }
  },
  "required": ["fields", "sub_tables", "needs_review"]
}
