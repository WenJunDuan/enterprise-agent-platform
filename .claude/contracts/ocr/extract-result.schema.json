{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ocr_extract_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["excel", "word", "text", "pdf_text", "ocr", "seal"]
    },
    "route": {
      "type": "string",
      "enum": ["native", "ocr", "manual"]
    },
    "blocks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tables": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "pages": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "seals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bbox": { "type": "array", "items": { "type": "number" } },
          "shape": { "type": "string" },
          "text": { "type": "string" },
          "color": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "meta": { "type": "object", "additionalProperties": true }
  },
  "required": ["path", "kind"]
}
