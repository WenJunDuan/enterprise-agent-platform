{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "expense_extract_result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "employee_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "employee_id",
        "department"
      ]
    },
    "expense": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "amount",
        "currency",
        "date",
        "description"
      ]
    },
    "invoice_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "application_form",
              "invoice",
              "itinerary",
              "hotel_folio",
              "pre_approval",
              "receipt",
              "other"
            ]
          }
        },
        "required": [
          "name",
          "path",
          "media_type",
          "document_type"
        ]
      }
    },
    "extracted_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_by": {
      "type": "string",
      "const": "expense-extractor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "claim_id",
    "source_path",
    "applicant",
    "expense",
    "invoice_numbers",
    "attachments",
    "extracted_fields",
    "missing_fields",
    "ambiguities",
    "reviewed_by",
    "timestamp"
  ]
}
