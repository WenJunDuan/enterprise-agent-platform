# Audit Agent runtime env template.

MODEL_BASE_URL=http://litellm:4000
MODEL_AUTH_TOKEN=sk-litellm-change-me
MODEL_NAME=claude-opus-4-8
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

TENANT_KEYS={"default":"sk-change-me-tenant-token"}
ALLOW_INSECURE_DEFAULT_TENANT_KEY=false

APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=9999
SERVE_UI_DIST=true

# === 运行日志（log4j2 风格 file appender）===
# 控制台始终输出；下列控制 logs/app/ 下的文件落盘。serve / app-server 默认开启，
# 不设时按业务自检（测试默认不写盘）。LOG_LEVEL 控根级别(INFO/DEBUG/WARNING)。
LOG_LEVEL=INFO
# 文件落盘开关：app.log(INFO+) + error.log(WARN+)。serve/app-server 默认 true；显式设可覆盖。
LOG_TO_FILES=true
# 单文件滚动阈值(字节，默认 50MB)与 gz 备份保留数(默认 10)。
# LOG_MAX_BYTES=52428800
# LOG_BACKUP_COUNT=10
# LOG_FORMAT=json   # 控制台格式 json|kv；DEV=1 时自动 kv

# 注：无 SDK 层成本封顶（max_budget_usd 已移除）。单次调用成本由内联最大轮数
# (AUDIT_INLINE_MAX_TURNS,默认 8) + 下列硬超时 + 并发上限三道闸门联合约束。
# 单次审核硬超时（秒）。默认 180；现场内网模型/网络慢、或结构化输出重试多时调大，
AUDIT_TIMEOUT_SEC=600
# 并发审核上限（信号量）。默认 2；慢模型/单卡部署勿调高，避免排队拖垮整体延迟。
MAX_CONCURRENT_AUDITS=2
# （次要）卡死任务回收阈值（秒），只在服务重启时清理残留 running 任务，默认 600。
AUDIT_TASK_RUNNING_TIMEOUT_SECONDS=900

# === 审核能力开关（逐项验证模型能力后再开，勿一次性全开）===
# 失败自动重试次数：契约校验失败或 CLI 偶发崩溃时重跑一次。默认 1；设 0 关闭。
AUDIT_CONTRACT_MAX_RETRY=1

# 多模态读附件原件（发票 / 行程图片）。默认 0 = 文本模式不给 Read 工具（低延迟）。
# 设 1 后即便文本模式也允许模型 Read 附件原件核验（每次 Read 是一次网关往返，会变慢）。
AUDIT_ENABLE_READ=0

# 强制结构化输出（SDK json_schema）。默认 0 = 文本模式（服务端解析 JSON），兼容不支持
# 原生结构化输出的网关模型。设 1 前需确认 litellm + 模型支持 json_schema。
AUDIT_STRUCTURED_OUTPUT=0

# 加载项目 .claude/settings.json（含 hooks）。默认 1 = 精简上下文、不加载（更快）。
# 设 0 才会加载项目设置/hooks；check-before-write 等 Write hook 仅在此为 0 时才可能触发。
AUDIT_LEAN_CONTEXT=1

# 内联审核单次会话最大轮数。默认 8；案件已预加载，正常 1-2 轮即出结论，调大仅为
# 给开启 Read 核验时留余量。
AUDIT_INLINE_MAX_TURNS=8

# 写入结果校验守卫（check-before-write hook）。默认空 = 关闭。设 1 启用，但还需
# AUDIT_LEAN_CONTEXT=0 且结果经 Write 工具写入才会真正触发（见 hook 内注释）。
AUDIT_WRITE_VALIDATION_ENABLED=0

# 二次 SDK 复核。默认空 = 关闭（开启会使每单审核耗时翻倍）。
SECOND_REVIEW_ENABLED=0

# CLI 最大输出 token。本地 65536 上下文模型必须压低（如 16000）避免撞 400；
# 大上下文云模型可留默认。按部署模型填。
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=16000

# SDK 单条 stdout JSON 消息缓冲上限（字节）。默认 20MiB(20971520)。评标注入大 OCR 底稿 /
# agent 直读大 PDF 的 tool_result 会超 SDK 原生 1MiB 上限导致整单失败；附件特别大时再调高。
# CLAUDE_MAX_BUFFER_BYTES=20971520

# === 文档识别 / 表单回填 ===
OCR_VL_SERVER_URL=http://litellm:4000
OCR_VL_MODEL_NAME=paddleocr

# 可选：向后端并发数 / 印章产线名。
# OCR_VL_MAX_CONCURRENCY=4
# OCR_SEAL_PIPELINE=seal_recognition

# === 外部企业信用查询 API（G3，可选）===
# 留空 = 未接入：评分项命中 requires_external_data（企业信用）时保持 manual_review（人工审核）。
# 结果契约见 .claude/contracts/tools/credit-check.schema.json；真实 API 字段名不同时，
# 在 server/ops/credit_api.py 的 _fetch_raw 里加一层映射。CLI 自检：python -m server.cli credit-check <企业名>
CREDIT_API_URL=
CREDIT_API_KEY=
CREDIT_API_TIMEOUT_SECONDS=10

CORS_ALLOWED_ORIGINS=http://localhost:9999,http://127.0.0.1:9999,http://192.168.1.24:9999
NO_PROXY=localhost,127.0.0.1,::1,192.168.0.0/16,192.168.1.0/24,.local,litellm,10.200.52.29