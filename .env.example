# Compatibility layer used by this project. This is the minimum recommended CLI path.
MODEL_BASE_URL=http://your-model-gateway.example.com
MODEL_API_KEY=your-model-api-key
# MODEL_AUTH_TOKEN=your-claude-gateway-access-token
MODEL_NAME=gpt-5.4
# Optional JSON object or raw `Name: Value` lines for gateways that require extra headers
# MODEL_CUSTOM_HEADERS={"HTTP-Referer":"https://your-app.example.com","X-Title":"enterprise-agent-platform"}
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/service.log
APP_MEMORY_ROOT=knowledge/memory
SLOW_REQUEST_THRESHOLD_SECONDS=10
UPSTREAM_TIMEOUT_SECONDS=60
MAX_BUDGET_USD=1.0
TENANT_KEYS={"default":"sk-default"}
AUDIT_TASK_RUNNING_TIMEOUT_SECONDS=600
SUBMISSION_RETENTION_DAYS=7
MAX_UPLOAD_FILE_BYTES=10485760
# Optional override for the post-write review hook. If omitted and MODEL_NAME is external,
# the review hook falls back to the mapped haiku alias on the same gateway.
# SECOND_REVIEW_MODEL=gpt-5.4-mini
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000
ALLOW_UNSCOPED_CONTINUE_RECENT=false
SESSION_ARCHIVE_AFTER_DAYS=7
APP_SERVER_LOG_MAX_BYTES=5242880
APP_SERVER_LOG_BACKUPS=5
