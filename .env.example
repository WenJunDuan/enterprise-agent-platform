# 企业智能审核平台 · 环境变量样例
# 用法：cp .env.example .env，按需填值。.env 已被 .gitignore（勿提交真实密钥）。

# ── 模型网关（必填）─────────────────────────────────────────────
# 内网部署禁止连 api.anthropic.com；指向自托管/网关地址。
MODEL_BASE_URL=
ANTHROPIC_API_KEY=

# ── 租户鉴权 ────────────────────────────────────────────────────
# 形如 tenantA:token-a,tenantB:token-b（生产必填，默认 key 会被强制 503 拒绝）。
TENANT_KEYS=

# ── 服务进程 ────────────────────────────────────────────────────
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000

# ── 外部企业信用查询 API（G3，可选）────────────────────────────
# 留空 = 未接入：评分项命中 requires_external_data（企业信用）时保持 manual_review（人工审核）。
# 接入时只需填下面两项（无需改代码），系统即自动调用并把结果先过契约校验再用：
#   CREDIT_API_URL = 企业信用查询 API 的 GET 端点（工具会以 ?q=<企业名/信用代码> 调用，Bearer key 鉴权）
#   CREDIT_API_KEY = 该 API 的访问密钥
# 结果契约见 .claude/contracts/tools/credit-check.schema.json；若真实 API 字段名不同，
# 在 server/ops/credit_api.py 的 _fetch_raw 里加一层映射规范成契约字段。
CREDIT_API_URL=
CREDIT_API_KEY=
CREDIT_API_TIMEOUT_SECONDS=10
