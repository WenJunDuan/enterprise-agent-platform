# 模型网关地址；这是当前项目最常用、最推荐填写的主入口。
MODEL_BASE_URL=http://your-model-gateway.example.com
# 模型网关 API Key。
MODEL_API_KEY=your-model-api-key
# 可选的网关鉴权 token；当网关需要 token 与 API key 分离时使用。
# MODEL_AUTH_TOKEN=your-claude-gateway-access-token
# 实际调用的后端模型名称；运行时会自动映射到 Claude SDK 可识别的模型别名。
MODEL_NAME=gpt-5.4
# 可选的网关自定义请求头；支持 JSON 对象格式。
# MODEL_CUSTOM_HEADERS={"HTTP-Referer":"https://your-app.example.com","X-Title":"enterprise-agent-platform"}
# 服务日志级别。
APP_LOG_LEVEL=INFO
# 服务日志文件路径。
APP_LOG_FILE=logs/service.log
# 应用记忆目录。
APP_MEMORY_ROOT=knowledge/memory
# 慢请求阈值，单位秒；超过后可用于诊断或告警。
SLOW_REQUEST_THRESHOLD_SECONDS=10
# 上游模型调用超时，单位秒。
UPSTREAM_TIMEOUT_SECONDS=60
# 单次 Claude / SDK 调用允许消耗的美元预算上限。
MAX_BUDGET_USD=1.0
# HTTP API 的租户 token 配置；左边是租户名，右边是请求时 Bearer token。
TENANT_KEYS={"default":"sk-default"}
# 异步审核任务处于 running 状态的超时阈值，单位秒；服务启动时会按它回收超时任务。
AUDIT_TASK_RUNNING_TIMEOUT_SECONDS=600
# 上传产生的 submission 目录保留天数；维护任务会按这个值清理旧目录。
SUBMISSION_RETENTION_DAYS=7
# 单个上传文件的大小上限，单位字节；当前默认约 10 MB。
MAX_UPLOAD_FILE_BYTES=10485760
# 可选的二次审查模型；不填时会按当前主模型或默认映射自动选择。
# SECOND_REVIEW_MODEL=gpt-5.4-mini
# 服务监听地址；本机调试用 127.0.0.1，对外提供服务通常改为 0.0.0.0。
APP_SERVER_HOST=127.0.0.1
# 服务监听端口。
APP_SERVER_PORT=8000
# 是否允许未指定 conversation_id 时继续最近会话；默认关闭。
ALLOW_UNSCOPED_CONTINUE_RECENT=false
# 会话事件日志归档阈值，单位天。
SESSION_ARCHIVE_AFTER_DAYS=7
# app-server stdout/stderr 单个日志文件的最大字节数。
APP_SERVER_LOG_MAX_BYTES=5242880
# app-server 日志轮转备份数量。
APP_SERVER_LOG_BACKUPS=5
# 是否允许使用示例或默认的租户 API key；生产环境请务必改为 false。
ALLOW_INSECURE_DEFAULT_TENANT_KEY=true
